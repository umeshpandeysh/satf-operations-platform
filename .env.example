# SATF Operations Platform — Environment Configuration Template
# Copy this file to .env.local for local development, or set in production hosting environment (e.g. Vercel, Supabase, Cloudflare).

# -----------------------------------------------------------------------------
# 1. Supabase Database Connection (Required for persistent operations)
# -----------------------------------------------------------------------------
# Base URL of your Supabase project (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service_role key with elevated database access for secure server APIs.
# NEVER expose this key to browser clients or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# 2. Cloudflare Zero Trust (Access) & Role Authorization (Required in Production)
# -----------------------------------------------------------------------------
# Cloudflare Access organization/team name (e.g. satf-ops for https://satf-ops.cloudflareaccess.com)
CF_ACCESS_TEAM_NAME=satf-ops

# Cloudflare Access Application Audience (AUD) tag (64-character hex string from Cloudflare Access app overview)
CF_ACCESS_AUD=your_64_character_hex_aud_tag_here

# Comma-separated list of staff emails assigned privileged Lead Coordinator permissions
# (Permitted to cancel tours, execute live workbook commits, and clear datasets)
SATF_LEAD_COORDINATOR_EMAILS=lead.ops@southasiantourfabric.com,management@stworld.jp

# Optional comma-separated list of approved standard coordinator emails.
# If omitted, any identity authenticated by Cloudflare with @southasiatravelfactory.com or @stworld.jp is accepted.
SATF_AUTHORIZED_COORDINATOR_EMAILS=

# Explicit local development opt-in bypass (Ignored in production; only works when NODE_ENV === 'development')
SATF_DEV_AUTH_BYPASS=false

# Cryptographic secret for signing session HMAC-SHA256 tokens and internal state.
SATF_SESSION_SECRET=your_random_32_byte_session_secret_hex_or_base64

# -----------------------------------------------------------------------------
# 3. Individual Coordinator Accounts & RFC 6238 TOTP MFA (Optional)
# -----------------------------------------------------------------------------
# JSON string array defining individual coordinator accounts with role-based access
# and optional RFC 6238 TOTP two-factor authentication secrets.
# Supported roles: "lead_coordinator", "coordinator", "dispatcher"
# Example value:
# SATF_COORDINATORS='[{"id":"coord-1","username":"lead.ops","name":"Lead Ops Coordinator","role":"lead_coordinator","passphrase":"coord-secure-passphrase","totpSecret":"JBSWY3DPEHPK3PXP"}]'
# SATF_COORDINATORS=

# -----------------------------------------------------------------------------
# 4. Host & Origin Security (Recommended in production)
# -----------------------------------------------------------------------------
# Expected deployment origin to enforce strict Cross-Site Request Forgery (CSRF) origin validation.
# NEXT_PUBLIC_APP_URL=https://ops.southasiantourfabric.com

# -----------------------------------------------------------------------------
# 5. Inbound Client Email Gateway (Optional — Microsoft 365 or Google Workspace)
# -----------------------------------------------------------------------------
# Provider identifier: "microsoft_365" | "google_workspace" | "imap_smtp"
# SATF_EMAIL_PROVIDER=microsoft_365

# Dedicated operations inbound mailbox address:
# SATF_EMAIL_USER=ops@southasiatravelfactory.com

# Option A: Microsoft 365 (via Microsoft Graph REST API v1.0 OAuth2 App Registration)
# Required Azure App Registration Permissions: Mail.Read (Application permission with Admin Consent)
# SATF_M365_TENANT_ID=your-azure-tenant-guid-here
# SATF_M365_CLIENT_ID=your-azure-app-client-id-here
# SATF_M365_CLIENT_SECRET=your-azure-app-client-secret-here

# Option B: Google Workspace (via Gmail REST API v1 OAuth2)
# Required Scope: https://www.googleapis.com/auth/gmail.readonly
# SATF_GWORKSPACE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# SATF_GWORKSPACE_CLIENT_SECRET=your-google-oauth-client-secret
# SATF_GWORKSPACE_REFRESH_TOKEN=your-google-oauth-refresh-token

